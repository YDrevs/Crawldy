APP_ENV=local
LOG_LEVEL=INFO
API_KEYS=dev-key-change-me

DATABASE_URL=postgresql+asyncpg://seo:seo@postgres:5432/seo
REDIS_URL=redis://redis:6379/0

# psi | lighthouse | auto
PERF_PROVIDER=psi
PSI_API_KEY=
LIGHTHOUSE_URL=http://lighthouse:3000

CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=2
CRAWL_CONCURRENCY=5
HTTP_TIMEOUT_S=15
MAX_RESPONSE_BYTES=5242880
AUDIT_TIMEOUT_S=600
# Адреса в дужках має бути справжньою або відсутньою: заглушку
# example.com частина WAF відбиває як ознаку скрапера.
USER_AGENT=SeoAgentBot/0.1
ALLOW_PRIVATE_HOSTS=false
# Контакт для скриптів збору корпусу (scripts/samples/). Wikidata і
# Tranco просять назвати себе тому, хто тягне з них масово. Порожньо —
# і ці скрипти відмовляться працювати, замість підставити вигадану
# адресу. До User-Agent самого аудиту стосунку не має.
CRAWLER_CONTACT=

# ── Веб і межі публічного доступу ────────────────────────────────────
# Порожньо — дозволені лише локальні адреси розробки.
CORS_ORIGINS=
# Скільки анонімних аудитів з однієї адреси за вікно.
PUBLIC_RATE_LIMIT=10
PUBLIC_RATE_WINDOW_SECONDS=3600
# Окремо — повторне відкриття власної каси. Воно віддає ту саму покупку
# й ту саму транзакцію, тобто нічого не створює, тож спільна десятка
# лише заважала б тому, хто закрив вікно оплати й повернувся.
CHECKOUT_RATE_LIMIT=60
# Сіль для хешу IP у гостьових сесіях. У продакшені задати випадковою:
# без неї хеш відтворюваний, і «анонімний» лічильник перестає бути анонімним.
IP_HASH_SALT=
# Вмикати лише за справжнім проксі: інакше клієнт сам призначає собі IP.
TRUST_PROXY_HEADERS=false
# Скільки наших проксі дописують адресу в X-Forwarded-For. Справжній
# клієнт — N-й запис справа; лівіші прислав сам клієнт.
TRUSTED_PROXY_HOPS=1

# ── Рендеринг (Playwright) ───────────────────────────────────────────
RENDER_ENABLED=true
RENDER_MAX_PAGES=3
RENDER_TIMEOUT_S=30

# Скільки днів прав лишається після невдалого списання.
BILLING_PAST_DUE_GRACE_DAYS=7
# Порожньо — політика повернення квоти за замовчуванням.
BILLING_REFUNDABLE_FAILURES=

# ── Семантичний шар (LEGACY, вимкнений) ──────────────────────────────
# Впливає на бал, коли увімкнений. Не вмикати без окремого рішення.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_PAGES=3
LLM_MAX_TOKENS=2000
LLM_EFFORT=low

# ── AI Enrichment (фаза 1, експериментальна) ─────────────────────────
# Стоїть ПІСЛЯ детерміністичної правди й не може змінити бал.
# Вимкнено; запуск потребує ще й явного внутрішнього тригера.
ENRICH_ENABLED=false
OPENAI_API_KEY=

# ── Actual AI Presence (P0, beta) ────────────────────────────────────
# Ключ третього провайдера присутності. Політика виконання (провайдери,
# промпти, бюджети) — в адмін-конфігурації домену, не в оточенні.
PERPLEXITY_API_KEY=

# Ключ Gemini API (Google AI Studio) — лише бекенд developer_api
# (сумісність/діагностика). Проєкт ключа мусить мати ввімкнений
# Generative Language (Gemini) API. Автентифікацією Vertex цей ключ
# не буває ніколи.
GOOGLE_API_KEY=
# Vertex AI — продуктовий бекенд google-провайдера присутності.
# Ідентифікатор проєкту Google Cloud (не секрет). Секретів тут немає:
# автентифікація — ADC (`gcloud auth application-default login`)
# локально або workload identity у деплої; проєкту потрібні ввімкнений
# aiplatform.googleapis.com і роль roles/aiplatform.user.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
ENRICH_MAX_ATTEMPTS=2
# Стеля виходу й таймаут за замовчуванням; фактичні межі — на задачу,
# в app/enrich/budgets.py.
ENRICH_ATTEMPT_TIMEOUT_S=45
ENRICH_MAX_OUTPUT_TOKENS=3000

# Хто обслуговує касу: fake | paddle. Фейк — для розробки без ключів;
# у app_env=prod він не реєструється взагалі, тож лишити його там
# випадково неможливо.
BILLING_PROVIDER=fake
# Ключ шифрування секретів, які адміністратор зберігає зі службового
# кабінету (таблиця runtime_settings). Без нього секрети читаються з
# оточення як раніше, але зберегти новий зі сторінки неможливо.
SECRETS_KEY=


# ── Paddle (перший платіжний провайдер, поки лише пісочниця) ─────────
# sandbox | live. Ключ мусить відповідати оточенню: адаптер перевіряє
# це за префіксом і відмовляє, якщо їх переплутано.
PADDLE_ENV=sandbox
# Ключ API. НІКОЛИ не потрапляє у фронтенд.
PADDLE_API_KEY=
# Токен для браузера — публічний за задумом Paddle.
PADDLE_CLIENT_TOKEN=
# Видається Paddle при створенні призначення сповіщень. Поки порожній,
# вебхук відхиляє все: перевірити підпис нічим.
PADDLE_WEBHOOK_SECRET=
PADDLE_TIMEOUT_S=20
PADDLE_SIGNATURE_TOLERANCE_S=300

# ── Контактна форма ──────────────────────────────────────────────────
# Антибот. Секрет живе ЛИШЕ на сервері; у браузер їде тільки site-key,
# і те через API — конфігурація провайдера лишається в одному місці.
# Без секрету перевірки немає: у проді форма тоді чесно відмовляє,
# замість того щоб приймати звернення без жодного захисту.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Куди доставляти звернення. Адреса не потрапляє ані в базу, ані у
# відповідь API: те, чого немає в клієнті, не збирають поштові роботи.
# Без хоста й одержувача транспорту немає, і в проді форма відмовляє —
# кнопка, яка нікуди не доставляє, гірша за її відсутність.
CONTACT_RECIPIENT=
CONTACT_SENDER=
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USERNAME=
CONTACT_SMTP_PASSWORD=
CONTACT_SMTP_TLS=true

# Захист від зловживання формою. Вікно власне, окреме від запуску
# аудитів: інакше спам у форму глушив би головну дію продукту. До
# комерційних прав (скільки аудитів входить у план) стосунку не має.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600

# ── Відновлення пароля ────────────────────────────────────────────────
# Адреса САЙТУ, куди веде посилання з листа. Не адреса API: лист
# відкриває людина в браузері, і в проді це різні домени.
PUBLIC_APP_URL=http://localhost:3000

# Скільки живе посилання, у хвилинах.
PASSWORD_RESET_TTL_MINUTES=60

# Власне вікно обмеження. Окреме від контактної форми: спам у форму не
# має закривати людині вхід до акаунта.
RECOVERY_RATE_LIMIT=5
RECOVERY_RATE_WINDOW_SECONDS=3600
# Вхід і створення акаунта (реєстрація, claim) з однієї адреси.
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=900
SIGNUP_RATE_LIMIT=20
SIGNUP_RATE_WINDOW_SECONDS=3600

# Пошта для листів КОРИСТУВАЧЕВІ (відновлення пароля). Окрема від
# CONTACT_*: там одержувач завжди один — ми самі, тут різний щоразу.
# Без MAIL_SMTP_HOST лист нікуди не йде, і система про це каже прямо,
# а не вдає успіх.
MAIL_SENDER=
# Куди піде відповідь людини. Порожньо — заголовка немає.
MAIL_REPLY_TO=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_TLS=true

# Локальне перехоплення листів у файли .eml. Порожньо — лише в памʼять.
MAIL_CAPTURE_DIR=
