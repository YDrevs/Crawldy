# Змінні самого стека (compose і Caddy). Скопіюйте в `deploy/.env`.
# Налаштування застосунку — окремо, у `backend/.env` (див. README).
#
# Паролі генеруйте так (hex — без символів, які ламають URL):
#   openssl rand -hex 32

SITE_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Звідки брати образи (автодеплой). Порожньо — збірка на сервері.
IMAGE_REGISTRY=ghcr.io/ydrevs
