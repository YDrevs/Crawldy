# Відновлює мережевий фільтр воркера після перезавантаження сервера:
# правила iptables не переживають reboot.
#
#   sudo cp crawldy-egress.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now crawldy-egress
#
# Шлях нижче — /opt/crawldy, як у README; клонували деінде — виправте його.

[Unit]
Description=Crawldy worker egress filter
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/crawldy/source/deploy/egress-firewall.sh

[Install]
WantedBy=multi-user.target
